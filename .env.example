# Entorno general
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/threads_engine?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Proveedor de IA (gemini o mock)
AI_PROVIDER=gemini
GEMINI_API_KEY=""

# Integración con Meta Threads (mock o real)
THREADS_PROVIDER=mock
THREADS_APP_ID=""
THREADS_APP_SECRET=""
THREADS_ACCESS_TOKEN=""
THREADS_USER_ID=""

# Seguridad y Autenticación
JWT_SECRET="threads-content-engine-secret-key-super-secure"
SESSION_SECRET="session-secret-change-in-production"
