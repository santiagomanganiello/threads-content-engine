{
  "name": "@threads-engine/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker:generation": "tsx watch src/workers/generation.worker.ts",
    "worker:publishing": "tsx watch src/workers/publishing.worker.ts",
    "test:gemini": "tsx src/scripts/test-gemini.ts",
    "verify:threads": "tsx src/scripts/verify-threads.ts",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../../prisma/schema.prisma",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.4.1",
    "@threads-engine/contracts": "workspace:*",
    "bullmq": "^5.41.6",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
